# Local demonstration only. Use your product's existing authentication in production.
DEMO_USERNAME=demo
DEMO_PASSWORD=replace-with-a-long-local-password
OPENAI_API_KEY=
# Verify model availability and tool calling when reusing this example.
OPENAI_MODEL=gpt-6-luna
NANGO_API_KEY=
NANGO_CONNECTION_ID=
NANGO_INTEGRATION_ID=google-tasks
# Needed by CLI only, not by the running product agent.
NANGO_SECRET_KEY_DEV=
PORT=3610
DEMO_TODAY=2026-11-11
DEMO_TIMEZONE=Africa/Lagos
# Read-only until the custom tool is deployed:
ENABLE_DISCOVERY_PREP=false
# For verify:live after you create the controlled test list:
TEST_TASK_LIST_ID=
