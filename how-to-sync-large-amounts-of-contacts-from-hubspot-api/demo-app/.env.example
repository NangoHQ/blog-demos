# Copy this file to .env and fill in real values.
# Find your dev secret key in the Nango dashboard → Environment Settings → API keys.

NANGO_SECRET_KEY_DEV=

# --- Optional overrides ---

# If your Nango environment uses a separate webhook signing key, set it here.
# By default, signature verification uses NANGO_SECRET_KEY_DEV (matching the Node SDK).
# NANGO_WEBHOOK_SIGNING_KEY=

# Custom Nango host (e.g., self-hosted). Defaults to https://api.nango.dev
# NANGO_HOST=

# Server port. Defaults to 3000.
# PORT=3000
