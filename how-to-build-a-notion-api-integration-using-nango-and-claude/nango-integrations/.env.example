# Authenticates the Nango CLI for `nango dryrun` / `nango deploy`.
# Get it from the dashboard: https://app.nango.dev/dev/environment-settings
NANGO_SECRET_KEY_DEV=

# Optional: production key for `nango deploy prod`.
# NANGO_SECRET_KEY_PROD=

# Optional: Nango instance URL (defaults to https://api.nango.dev; change for self-hosted/OSS).
# NANGO_HOSTPORT=https://api.nango.dev
