# Nango secret key (Nango dashboard → Environment Settings).
# Stays on the server — the browser never sees it.
NANGO_SECRET_KEY=

# Anthropic API key for the AI assistant (Claude). Optional — only the
# Assistant tab needs it; Connect / sync / create-page work without it.
ANTHROPIC_API_KEY=

# Optional. Defaults to https://api.nango.dev. Set for a self-hosted Nango.
# NANGO_HOST=https://api.nango.dev

# Port the backend listens on. The Vite dev server proxies /api here.
PORT=3010
